<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/home.css" />
</head>

<body>
  <div class="top-banner">
    <p>WE CREATE GREAT GAMES TOGETHER. <a href="#contact">JOIN US</a></p>
  </div>

  <header class="site-header">
    <a href="/" class="logo">
      <span class="logo-mark">
        <svg width="58" height="38" viewBox="0 0 58 38" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="6" width="52" height="26" rx="7" stroke="#071E33" stroke-width="4"/>
          <path d="M17 14V24M12 19H22" stroke="#23CFFF" stroke-width="3.4" stroke-linecap="round"/>
          <circle cx="37" cy="16" r="3" fill="#FBD43B"/>
          <circle cx="45" cy="16" r="3" fill="#2AD26D"/>
          <circle cx="41" cy="23" r="3" fill="#FF6A2A"/>
          <circle cx="49" cy="23" r="3" fill="#2E8BFF"/>
        </svg>
      </span>

      <span class="logo-text">
        Fantasy
      </span>
    </a>

    <nav class="navbar">
      <a href="/" class="active">Home</a>
      <a href="#about">About</a>
      <a href="#games">Game</a>
      <a href="#contact">Contact</a>
    </nav>

    <div class="header-contact">
      <a href="mailto:FantasyStudiodn@gmail.com">[ FantasyStudiodn@gmail.com ]</a>

      <button class="grid-btn" type="button" aria-label="Open menu">
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main>
    <section class="hero-section">
      <div class="hero-bg"></div>

      <div class="hero-content">
        <p class="hero-kicker">Fantasy becomes reality</p>

        <h1>
          Fantasy
          <span>Studio</span>
        </h1>

        <p class="hero-description">
          Chúng tôi là đội ngũ phát triển game mobile và Steam, nơi những ý tưởng sáng tạo
          được biến thành các thế giới game sống động, vui nhộn và đầy cảm xúc.
        </p>

        <div class="hero-actions">
          <a href="#games" class="primary-btn">Khám phá game</a>
          <a href="#about" class="secondary-btn">Về chúng tôi</a>
        </div>
      </div>

      <div class="hero-character">
        <div class="character-glow"></div>

        <!-- 
          Thay ảnh bên dưới bằng nhân vật/game mascot của Fantasy Studio.
          Ví dụ: /assets/hero-character.png
        -->
        <img 
        class="hero-mascot" 
        src="/assets/fantasy-hero-character.png" 
        alt="Fantasy Studio Character"
        />
      </div>

      <div class="scroll-indicator">
        <span></span>
        Scroll down
      </div>
    </section>

    <section id="games" class="games-section">
  <div class="games-container">
    <div class="games-copy">
      <p class="section-kicker">[ Our Games ]</p>

      <h2>
        We create games<br />
        inspired by Vietnam,<br />
        made for players.
      </h2>

      <p>
        Fantasy Studio phát triển các tựa game mobile và Steam với tinh thần sáng tạo,
        trẻ trung và gần gũi. Mỗi sản phẩm là một thế giới riêng, được xây dựng từ ý tưởng,
        gameplay và cảm hứng văn hóa Việt Nam.
      </p>

      <a href="#contact" class="outline-btn">[ Hợp tác cùng chúng tôi ]</a>
    </div>

    <div class="game-card-grid">
      <article class="game-card">
        <div class="game-logo placeholder-logo">
          <span>VB</span>
        </div>

        <div class="game-number">[ 01 ]</div>

        <h3>Vietnamese<br />Bird</h3>

        <p class="game-status completed">Đã hoàn thành</p>
      </article>

      <article class="game-card">
        <div class="game-logo">
          <img src="/assets/games/vietnam-wonder-logo.jpg" alt="Vietnam Wonder Logo">
        </div>

        <div class="game-number">[ 02 ]</div>

        <h3>Vietnam<br />Wonder</h3>

        <p class="game-status releasing">Đang release</p>
      </article>

      <article class="game-card active">
        <div class="game-logo circle-logo">
          <img src="/assets/games/lac-viet-warrior-logo.jpg" alt="Lac Viet Warrior Logo">
        </div>

        <div class="game-number">[ 03 ]</div>

        <h3>Lac Viet<br />Warrior</h3>

        <p class="game-status developing">Đang phát triển</p>

        <p class="game-desc">
          Một dự án lấy cảm hứng từ tinh thần Lạc Việt, kết hợp yếu tố phiêu lưu,
          chiến đấu và thế giới fantasy.
        </p>
      </article>

      <article class="game-card">
        <div class="game-logo wide-logo">
          <img src="/assets/games/vietnam-rush-logo.jpg" alt="VietNam Rush Logo">
        </div>

        <div class="game-number">[ 04 ]</div>

        <h3>VietNam<br />Rush</h3>

        <p class="game-status developing">Đang phát triển</p>
      </article>
    </div>
  </div>
</section>

<section id="team-intro" class="team-intro-section">
  <div class="team-intro-container">
    <div class="team-intro-left">
      <img src="/assets/characters/team-left.png" alt="Fantasy Studio Character Left" />
    </div>

    <div class="team-intro-center">
      <div class="team-intro-logo">
        <div class="team-logo-badge">
          <svg width="58" height="38" viewBox="0 0 58 38" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="6" width="52" height="26" rx="7" stroke="#071E33" stroke-width="4"/>
            <path d="M17 14V24M12 19H22" stroke="#23CFFF" stroke-width="3.4" stroke-linecap="round"/>
            <circle cx="37" cy="16" r="3" fill="#FBD43B"/>
            <circle cx="45" cy="16" r="3" fill="#2AD26D"/>
            <circle cx="41" cy="23" r="3" fill="#FF6A2A"/>
            <circle cx="49" cy="23" r="3" fill="#2E8BFF"/>
          </svg>
        </div>

        <p>Fantasy Studio</p>
      </div>

      <p class="section-kicker">[ Our Team ]</p>

      <h2>
        Behind every game<br />
        is a team of creators,<br />
        dreamers and builders.
      </h2>

      <!-- <p class="team-intro-text">
        Đằng sau mỗi tựa game của Fantasy Studio là một tập thể đam mê sáng tạo,
        luôn cùng nhau nghiên cứu, thiết kế, phát triển và hoàn thiện từng trải nghiệm chơi game.
        Đây là nơi công nghệ, mỹ thuật và tinh thần đồng đội kết hợp để tạo nên những sản phẩm mang dấu ấn riêng.
      </p> -->
    </div>

    <div class="team-intro-right">
      <img src="/assets/characters/team-right.png" alt="Fantasy Studio Character Right" />
    </div>
  </div>
</section>

<section class="studio-video-section">
  <div class="studio-video-frame">
    <video 
      class="studio-video"
      id="studioVideo"
      poster="/assets/videos/studio-video-poster.jpg"
      preload="metadata"
    >
      <source src="/assets/videos/fantasy-studio-intro.mp4" type="video/mp4">
      Trình duyệt của bạn không hỗ trợ video.
    </video>

    <button class="video-play-btn" type="button" id="videoPlayBtn" aria-label="Play video">
      <span class="play-ring-text">PLAY • WATCH • PLAY • WATCH •</span>
      <span class="play-icon">▶</span>
    </button>

    <div class="video-placeholder-content">
      <p>Fantasy Studio</p>
      <h2>Team Story Video</h2>
      <span>Video sẽ được cập nhật sau</span>
    </div>
  </div>
</section>

<section id="team-showcase" class="team-showcase-section">
  <div class="team-showcase-container">
    <div class="team-showcase-heading">
      <p class="section-kicker">[ Our Members ]</p>
      <h2>Meet The Team</h2>
      <p>
        Những gương mặt đứng sau các sản phẩm của Fantasy Studio.
      </p>
    </div>

    <div class="team-carousel" data-team-carousel>
      <button class="team-nav-btn team-prev" type="button" aria-label="Previous member" data-team-prev>
        ‹
      </button>

      <div class="team-carousel-stage" data-team-stage></div>

      <button class="team-nav-btn team-next" type="button" aria-label="Next member" data-team-next>
        ›
      </button>
    </div>

    <div class="team-active-info">
      <p class="team-active-label">Thành viên đang hiển thị</p>
      <h3 data-team-name>Hoàng Duy Nhất</h3>
      <p data-team-role>Founder / Product Owner / Project Manager</p>
    </div>

    <div class="team-dots" data-team-dots></div>
  </div>
</section>
  </main>

  <script src="/js/home.js"></script>
</body>
</html>