<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Trang Thành viên & Team của Fantasy Studio" />
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="site-bg" aria-hidden="true"></div>

  <header class="header">
    <a href="/" class="brand" aria-label="Fantasy Studio">
      <span class="brand-icon" aria-hidden="true">
        <svg width="54" height="34" viewBox="0 0 54 34" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="4" width="50" height="26" rx="7" stroke="white" stroke-width="4"/>
          <path d="M16 12V22M11 17H21" stroke="#26D9FF" stroke-width="3.2" stroke-linecap="round"/>
          <circle cx="35" cy="14" r="2.8" fill="#FBD43B"/>
          <circle cx="42" cy="14" r="2.8" fill="#2AD26D"/>
          <circle cx="38.5" cy="20" r="2.8" fill="#FF6A2A"/>
          <circle cx="45" cy="20" r="2.8" fill="#2E8BFF"/>
        </svg>
      </span>
      <span class="brand-text">Fantasy <strong>Studio</strong></span>
    </a>

    <button class="menu-btn" type="button" aria-label="Mở menu" data-menu-btn>
      <span></span><span></span><span></span>
    </button>

    <nav class="nav" data-nav>
      <a href="#" class="nav-link">Trang chủ</a>
      <a href="#" class="nav-link">Giới thiệu game</a>
      <a href="/thanh-vien-team" class="nav-link active">Thành viên & Team</a>
      <a href="#" class="nav-link">Dự án</a>
      <a href="#contact" class="nav-link">Liên hệ</a>
    </nav>

    <a class="join-btn" href="#contact">Tham gia ngay</a>
  </header>

  <main>
    <section class="hero-section section-shell">
      <div class="hero-visual" aria-hidden="true"></div>

      <div class="hero-content">
        <p class="eyebrow">Đội ngũ của chúng tôi</p>
        <h1>Together, we create<br />games <span>beyond play.</span></h1>
        <p class="hero-desc">
          Chúng tôi là những nhà phát triển, nghệ sĩ và dreamer cùng chung đam mê tạo ra những trò chơi đẳng cấp.
        </p>
        <a class="primary-btn" href="#contact">Tham gia cùng chúng tôi <span>→</span></a>
      </div>

      <div class="stats-grid" aria-label="Thông số Fantasy Studio">
        <% stats.forEach((item) => { %>
          <article class="stat-card">
            <%- include('partials/icon', { name: item.icon }) %>
            <div>
              <strong><%= item.value %></strong>
              <span><%= item.label %></span>
            </div>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="members-section" aria-labelledby="featured-members-title">
      <div class="section-head">
        <h2 id="featured-members-title">Thành viên nổi bật</h2>
        <a href="#all-members">Xem tất cả thành viên <span>›</span></a>
      </div>

      <div class="member-slider" data-slider>
        <button class="slider-btn prev" type="button" aria-label="Thành viên trước" data-prev>‹</button>
        <div class="slider-stage" data-stage aria-live="polite"></div>
        <button class="slider-btn next" type="button" aria-label="Thành viên tiếp theo" data-next>›</button>
        <div class="slider-dots" data-dots aria-label="Điều hướng slide thành viên"></div>
      </div>
    </section>

    <section id="contact" class="cta-section section-shell compact">
      <div class="cta-icon-wrap">
        <div class="cta-icon"><%- include('partials/icon', { name: 'team' }) %></div>
      </div>

      <div class="cta-copy">
        <h2>Bạn có ý tưởng game?</h2>
        <p>Hãy để Fantasy Studio đồng hành cùng bạn biến ý tưởng của bạn thành trò chơi tuyệt vời.</p>
      </div>

      <a class="primary-btn cta-btn" href="mailto:contact@fantasystudio.vn">Liên hệ hợp tác <span>→</span></a>

      <div class="cta-controller" aria-hidden="true"></div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-brand">
      <a href="/" class="brand small" aria-label="Fantasy Studio">
        <span class="brand-icon" aria-hidden="true">
          <svg width="44" height="28" viewBox="0 0 54 34" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="4" width="50" height="26" rx="7" stroke="white" stroke-width="4"/>
            <path d="M16 12V22M11 17H21" stroke="#26D9FF" stroke-width="3.2" stroke-linecap="round"/>
            <circle cx="35" cy="14" r="2.8" fill="#FBD43B"/>
            <circle cx="42" cy="14" r="2.8" fill="#2AD26D"/>
            <circle cx="38.5" cy="20" r="2.8" fill="#FF6A2A"/>
            <circle cx="45" cy="20" r="2.8" fill="#2E8BFF"/>
          </svg>
        </span>
        <span class="brand-text">Fantasy <strong>Studio</strong></span>
      </a>
      <p>Fantasy Studio - Chúng tôi tạo ra những thế giới game chất lượng và đầy cảm hứng.</p>
    </div>

    <div>
      <h4>Studio</h4>
      <a href="#">Về chúng tôi</a>
      <a href="/thanh-vien-team">Thành viên</a>
      <a href="#">Tuyển dụng</a>
      <a href="#">Tin tức</a>
    </div>

    <div>
      <h4>Hỗ trợ</h4>
      <a href="#">Trung tâm hỗ trợ</a>
      <a href="#">Điều khoản</a>
      <a href="#">Chính sách bảo mật</a>
      <a href="#contact">Liên hệ</a>
    </div>

    <div>
      <h4>Kết nối</h4>
      <div class="socials">
        <a href="#" aria-label="Facebook">f</a>
        <a href="#" aria-label="Discord">⌾</a>
        <a href="#" aria-label="LinkedIn">in</a>
        <a href="#" aria-label="Youtube">▶</a>
      </div>
    </div>

    <p class="copyright">© 2024 Fantasy Studio. All rights reserved.</p>
  </footer>

  <script>
    window.__TEAM_MEMBERS__ = <%- JSON.stringify(members) %>;
  </script>
  <script src="/js/team-slider.js"></script>
</body>
</html>